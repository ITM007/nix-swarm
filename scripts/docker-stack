#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
secrets_dir="$root_dir/docker/nixos/secrets"
profile="${NIX_SWARM_DOCKER_PROFILE:-standard}"

case "${1:-}" in
  --profile) profile="${2:-}"; shift 2 ;;
  --profile=*) profile="${1#*=}"; shift ;;
esac

case "$profile" in
  standard) image_tag="dev"; package_suffix="" ;;
  hardened) image_tag="hardened"; package_suffix="-hardened" ;;
  *) echo "unknown Docker profile: $profile (use standard or hardened)" >&2; exit 2 ;;
esac

export NIX_SWARM_DOCKER_PROFILE="$profile"
export NIX_SWARM_DOCKER_IMAGE_TAG="$image_tag"
project_name="${NIX_SWARM_DOCKER_PROJECT:-nix-swarm-${profile}}"
project_name="${project_name//[^A-Za-z0-9_.-]/-}"
secrets_dir="$root_dir/_build/docker-secrets/$project_name"
export NIX_SWARM_DOCKER_PROJECT="$project_name"
export NIX_SWARM_DOCKER_SECRETS_DIR="$secrets_dir"

usage() {
  cat <<EOF
Usage: scripts/docker-stack [--profile standard|hardened] <command>

Commands:
  build   Build the three NixOS systemd images and load them into Docker
  up      Build images, start the nodes, seed SSH trust, and start operator
  status [--assert-ready]  Show or validate the four-service stack
  status --assert-ready    Fail unless node-a, node-b, node-c, and operator are healthy
  scenario <id>            Run a deterministic scenario from scripts/docker-scenarios
  evidence                 Capture bounded Compose diagnostics
  down    Stop and remove the stack (preserves named state volumes)
  reset   Stop the stack and remove all harness-owned state
  logs    Follow node logs
  shell   Open a root shell in node-a
  query   Run a read-only operator query through the operator container
EOF
}

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || -z "${1:-}" ]]; then
  usage
  [[ -n "${1:-}" ]] || exit 2
  exit 0
fi

resolve_runtime() {
  runtime_command="${NIX_SWARM_DOCKER_COMMAND:-docker}"

  if command -v "$runtime_command" >/dev/null 2>&1 && "$runtime_command" info >/dev/null 2>&1; then
    container_cmd=("$runtime_command")
  elif command -v sudo >/dev/null 2>&1 && sudo -n "$runtime_command" info >/dev/null 2>&1; then
    container_cmd=(sudo -n "$runtime_command")
  else
    echo "Docker is unavailable; no live Docker evidence was collected" >&2
    exit 1
  fi

  compose_cmd=("${container_cmd[@]}" compose --project-name "$project_name" --project-directory "$root_dir" -f "$root_dir/docker-compose.yml")
}
resolve_runtime

compose=("${compose_cmd[@]}")

ensure_secrets() {
  mkdir -p "$secrets_dir"
  if [[ ! -s "$secrets_dir/nix-swarm.cookie" ]]; then
    od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$secrets_dir/nix-swarm.cookie"
  fi
  chmod 0400 "$secrets_dir/nix-swarm.cookie"
  if [[ ! -s "$secrets_dir/id_ed25519" ]]; then
    command -v ssh-keygen >/dev/null 2>&1 || { echo "ssh-keygen is required" >&2; exit 1; }
    ssh-keygen -q -t ed25519 -N "" -f "$secrets_dir/id_ed25519"
  fi
  chmod 0600 "$secrets_dir/id_ed25519"
  chmod 0644 "$secrets_dir/id_ed25519.pub"
  touch "$secrets_dir/known_hosts"
  chmod 0644 "$secrets_dir/known_hosts"
}

build_images() {
  ensure_secrets
  for node in node-a node-b node-c; do
    echo "Building $profile NixOS image for $node..."
    nix build "$root_dir/docker/nixos#${node}${package_suffix}" --out-link "$root_dir/result-docker-$node-$profile"
    "${container_cmd[@]}" load < "$root_dir/result-docker-$node-$profile"
  done
}

wait_for_nodes() {
  for node in node-a node-b node-c; do
    for _attempt in $(seq 1 60); do
      if "${compose[@]}" exec -T "$node" /run/current-system/sw/bin/systemctl is-active --quiet nix-swarmd.service && \
         "${compose[@]}" exec -T "$node" /run/current-system/sw/bin/systemctl is-active --quiet sshd.socket; then break; fi
      sleep 2
    done
    "${compose[@]}" exec -T "$node" /run/current-system/sw/bin/systemctl is-active --quiet nix-swarmd.service
  done
}

seed_operator_known_hosts() {
  : > "$secrets_dir/known_hosts"
  "${compose[@]}" exec -T operator /run/current-system/sw/bin/sh -lc 'ssh-keyscan -H node-a node-b node-c >> /root/.ssh/known_hosts'
}

up() {
  build_images
  "${compose[@]}" up -d node-a node-b node-c
  wait_for_nodes
  "${compose[@]}" up -d operator
  seed_operator_known_hosts
  echo "Nix-Swarm Docker integration stack is ready (profile=$profile project=$project_name)."
}

status() {
  assert_ready="${1:-}"
  services="$("${compose[@]}" ps --services 2>/dev/null || true)"
  "${compose[@]}" ps
  if [[ "$assert_ready" != "--assert-ready" ]]; then return 0; fi
  expected=(node-a node-b node-c operator)
  for service in "${expected[@]}"; do
    if ! grep -qx "$service" <<<"$services"; then
      echo "empty_runtime: missing expected service $service" >&2
      return 1
    fi
  done
  health="$("${compose[@]}" ps --format '{{.Service}} {{.Health}}' 2>/dev/null || true)"
  for service in "${expected[@]}"; do
    if ! grep -Eq "^${service} (healthy|$)" <<<"$health"; then
      echo "service_healthy: $service is not healthy" >&2
      return 1
    fi
  done
}

evidence() {
  output="$root_dir/_build/docker-evidence/$profile.txt"
  mkdir -p "$(dirname "$output")"
  "${compose[@]}" ps | sed -E 's/(cookie|token|password|secret)=([^ ]+)/\1=[REDACTED]/Ig' | head -c 4000 > "$output"
  printf 'Docker evidence written to %s\n' "$output"
}

reset_resources() {
  "${compose[@]}" down -v --remove-orphans || true
  rm -f "$root_dir"/result-docker-*-standard "$root_dir"/result-docker-*-hardened
  rm -rf "$secrets_dir"
}

case "${1:-}" in
  build) build_images ;;
  up) up ;;
  down) "${compose[@]}" down --remove-orphans ;;
  reset) reset_resources ;;
  status) status "${2:-}" ;;
  scenario)
    shift
    if (($#)) && [[ "$1" != --* ]]; then
      scenario_id="$1"
      shift
      exec "$root_dir/scripts/docker-scenarios" --profile "$profile" --scenario "$scenario_id" "$@"
    fi
    exec "$root_dir/scripts/docker-scenarios" --profile "$profile" "$@"
    ;;
  evidence) evidence ;;
  logs) "${compose[@]}" logs -f --tail=100 node-a node-b node-c ;;
  shell) "${compose[@]}" exec node-a /run/current-system/sw/bin/bash ;;
  query)
    case "${2:-cluster-status}" in
      cluster-status) query_command=(cluster status) ;;
      cluster-members) query_command=(cluster members) ;;
      *) echo "unknown query: ${2:-} (use cluster-status or cluster-members)" >&2; exit 2 ;;
    esac
    "${compose[@]}" exec -T operator /run/current-system/sw/bin/nix-swarm "${query_command[@]}" --target "nix-swarm@node-a" --ssh-host "root@node-a"
    ;;
  *) usage; exit 2 ;;
esac
