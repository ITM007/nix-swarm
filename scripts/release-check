#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf 'usage: %s [--require-docker] [--revision REV] [--output DIR]\n' "$0" >&2
}

require_docker=false
revision=""
output="_build/release-evidence"
while (($#)); do
  case "$1" in
    --require-docker) require_docker=true; shift ;;
    --revision) [[ $# -ge 2 ]] || { usage; exit 2; }; revision=$2; shift 2 ;;
    --output) [[ $# -ge 2 ]] || { usage; exit 2; }; output=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

root=$(git rev-parse --show-toplevel)
cd "$root"
if [[ -z "$revision" ]]; then
  revision=$(git rev-parse HEAD)
fi
dirty_files=$(git status --porcelain --untracked-files=all | while IFS= read -r line; do
  path="${line:3}"
  case "$path" in
    .hermes/plans/*.md) ;;
    *) printf '%s\n' "$line" ;;
  esac
done)
if [[ -n "$dirty_files" ]]; then
  printf 'release-check: source checkout is dirty; commit or use an isolated clean checkout\n' >&2
  exit 1
fi

worktree=$(mktemp -d "${TMPDIR:-/tmp}/nix-swarm-release.XXXXXX")
project="nix-swarm-release-${RANDOM}-${BASHPID}"
docker_started=false
output_abs=$(mkdir -p "$output" && cd "$output" && pwd)
cleanup_status=0
cleanup() {
  set +e
  if $docker_started && [[ -d "$worktree" ]]; then
    for profile in standard hardened; do
      (cd "$worktree" && ./scripts/docker-stack --profile "$profile" reset) || cleanup_status=1
    done
  fi
  if command -v docker >/dev/null 2>&1; then
    docker compose -p "$project" down --volumes --remove-orphans >/dev/null 2>&1
    [[ -z "$(docker ps -aq --filter "label=com.docker.compose.project=$project")" ]] || cleanup_status=1
    [[ -z "$(docker network ls -q --filter "label=com.docker.compose.project=$project")" ]] || cleanup_status=1
    [[ -z "$(docker volume ls -q --filter "label=com.docker.compose.project=$project")" ]] || cleanup_status=1
  fi
  git worktree remove --force "$worktree" >/dev/null 2>&1 || cleanup_status=1
  rm -rf "$worktree"
  if ((cleanup_status != 0)); then
    printf 'release-check: cleanup failed for project %s\n' "$project" >&2
    return 1
  fi
}
trap cleanup EXIT

git worktree add --detach "$worktree" "$revision" >/dev/null
cd "$worktree"
starter_lock="examples/starter/flake.lock"
if [[ -f "$starter_lock" ]]; then
  locked_rev=$(awk '/"nix-swarm":/{seen=1} seen && /"rev":/{gsub(/[",]/, "", $2); print $2; exit}' "$starter_lock")
  if [[ -n "$locked_rev" && "$locked_rev" != "$revision" ]]; then
    printf 'release-check: examples/starter/flake.lock pins nix-swarm %s but releasing %s;\n' "$locked_rev" "$revision" >&2
    printf '  refresh with: (cd examples/starter && nix flake lock --update-input nix-swarm) and commit\n' >&2
    exit 1
  fi
fi
export COMPOSE_PROJECT_NAME="$project"
export NIX_SWARM_RELEASE_OUTPUT="$output_abs"

if $require_docker; then
  ./scripts/docker-stack --profile standard up
  docker_started=true
  ./scripts/docker-stack --profile hardened up
fi

args=(--output "$output_abs/evidence.txt")
$require_docker && args+=(--require-docker)

nix develop --command mix deps.get
nix develop --command mix run --no-start scripts/collect_release_evidence.exs -- "${args[@]}"
